# =============================================================================
#  Douglas-042 configuration
#
#  Ready to run as it stands. Read the two notes marked CHANGE THIS before
#  putting it anywhere real.
# =============================================================================

DOUGLAS_PORT=8000

# --- Console sign-in ---------------------------------------------------------
# Read ONLY to create the first admin account. After that, accounts are managed
# in the console and these values are ignored -- changing them later does not
# reopen a way in.
DOUGLAS_CONSOLE_USER=admin
DOUGLAS_CONSOLE_EMAIL=admin@douglas042.local

# CHANGE THIS. Left as it is, the console forces a password change at first
# sign-in, so a shipped default cannot survive unnoticed. Set your own here and
# that prompt is skipped.
DOUGLAS_CONSOLE_PASSWORD=douglas

# --- Session key -------------------------------------------------------------
# LEAVE THIS EMPTY. When empty, a key is generated on first start and kept at
# data/session.key with owner-only permissions, so sessions survive restarts.
#
# Do not paste a key that came with a download: every deployment holding the
# same package would share it, and anyone with it could forge a session cookie
# for someone else's console. Generate your own only if you run more than one
# console behind a load balancer and they must share sessions:
#   python3 -c "import secrets;print(secrets.token_hex(32))"
DOUGLAS_SESSION_SECRET=

# How long a sign-in lasts.
DOUGLAS_SESSION_HOURS=12

# --- Agent enrolment ---------------------------------------------------------
# Pins the token in the deploy command so it stays the same across restarts,
# which matters if you push the bootstrap line through GPO or Ansible. One has
# been generated for you; it is unique to this file.
#
# Anyone holding this token can enrol a host into your console. Treat it as a
# credential: keep this file readable only by the account running the service.
DOUGLAS_ENROLLMENT_TOKEN=

# --- Public address ----------------------------------------------------------
# LEAVE EMPTY unless you have to. When empty the console uses the address the
# browser reached it on and embeds that in deploy commands -- correct for a
# single-server install, and proven reachable because the request arrived on it.
#
# Putting an unreachable name here breaks EVERY agent installation the same
# way: the script downloads fine, then fails on its next call for reasons the
# error never explains. Only fill this in when you sit behind a proxy or NAT
# and auto-detection gets it wrong:
#   DOUGLAS_PUBLIC_URL=https://ir.example.local
# It can also be set from the Deploy agents screen without editing this file.
DOUGLAS_PUBLIC_URL=

# --- Limits ------------------------------------------------------------------
# An agent silent for longer than this shows as offline.
DOUGLAS_AGENT_TIMEOUT=120

# Evidence bundle ceiling. Raise it if you collect raw artifacts (registry
# hives, event logs) from large servers.
DOUGLAS_MAX_UPLOAD_MB=512
